# Database
# IMPORTANT:
# - Use the pooled URL for runtime app queries on Vercel/serverless.
# - Use the direct URL only for Prisma migrations / schema introspection.
# Both are required for Supabase + Vercel.
#
# SECURITY: never commit a real connection string. Put the actual values in the
# deployment platform's environment variable settings, not in this file.

# Pooled (transaction pooler). Used by the app at runtime.
# Note: "?pgbouncer=true" is required so Prisma avoids server-side prepared statements
# through PgBouncer, which would otherwise cause "prepared statement already exists".
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# Direct connection. Used by Prisma for migrations and schema introspection.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=public"

# Canonical domain.
# The apex pawvault.co.uk issues a 308 redirect to www.pawvault.co.uk, so
# www.pawvault.co.uk is the canonical origin and every absolute URL must use it.
NEXTAUTH_URL="https://www.pawvault.co.uk"
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

# Session cookie domain, read by src/lib/auth.ts in production.
# The leading dot shares the cookie across the apex and every subdomain, so the
# session survives the apex -> www redirect instead of being dropped.
NEXT_PUBLIC_COOKIE_DOMAIN=".pawvault.co.uk"

# OAuth callback URLs. These must exactly match the redirect URI registered in
# the Google and Discord developer consoles, and must use the canonical www host
# because a redirect on the callback URL discards the OAuth response.
# GOOGLE_CALLBACK_URL is not read by the app; NextAuth derives the Google
# callback from NEXTAUTH_URL. It is listed here for the provider dashboard.
DISCORD_CALLBACK_URL="https://www.pawvault.co.uk/api/auth/callback/discord"
GOOGLE_CALLBACK_URL="https://www.pawvault.co.uk/api/auth/callback/google"
# Enable OAuth buttons in the UI
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
NEXT_PUBLIC_DISCORD_AUTH_ENABLED="false"

# Stripe
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_YOUR_SECRET_KEY"
STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_WITH_YOUR_PUBLISHABLE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET"

# Connect
STRIPE_CONNECT_ENABLED="true"

# Site
# Single source of truth for absolute links in emails, Stripe redirects and
# checkout. Must match NEXTAUTH_URL.
NEXT_PUBLIC_APP_URL="https://www.pawvault.co.uk"

# Platform Fees (percentages, must sum to <= 100 with Stripe Connect)
NEXT_PUBLIC_PLATFORM_FEE_PERCENT="10"
NEXT_PUBLIC_MODERATOR_FEE_PERCENT="3"
NEXT_PUBLIC_SERVER_FEE_PERCENT="2"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# =========================================================
# FOUNDER BOOTSTRAP (one-time, secure)
# =========================================================
# The platform Founder is provisioned ONCE during initial deploy
# using `npm run make-founder`. The password is supplied via env,
# hashed immediately, and never stored or logged in plaintext.
#
# IMPORTANT:
# - Provide a STRONG temporary password here ONLY at setup.
# - Do NOT commit .env files.
# - After first login, the Founder should change their password
#   and remove/rotate FOUNDER_BOOTSTRAP_PASSWORD from your secrets.
# =========================================================
FOUNDER_EMAIL="you@example.com"
FOUNDER_USERNAME="your-username"
FOUNDER_DISPLAY_NAME="Your Name"
FOUNDER_BIO="Founder of PawVault."
FOUNDER_WEBSITE="https://www.pawvault.co.uk"
# FOUNDER_BOOTSTRAP_PASSWORD="REPLACE_WITH_A_STRONG_ONE_TIME_PASSWORD"
