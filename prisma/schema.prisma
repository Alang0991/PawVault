generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContentRating {
  SFW
  MATURE
  NSFW
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  REFUNDED
  DISPUTED
  SUSPENDED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
  ARCHIVED
  REJECTED
  SUSPENDED
  CHANGES_REQUESTED
  REMOVED
}

enum StoreVisibility {
  PUBLISHED
  HIDDEN
  SUSPENDED
  ARCHIVED
}

enum CreatorStatus {
  NONE
  APPLICATION_DRAFT
  APPLICATION_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  BANNED
  WITHDRAWN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  passwordHash   String
  displayName    String?
  role           String   @default("USER")
  status         UserStatus @default(ACTIVE)
  avatar         String?
  bio            String?
  website        String?
  location       String?
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  salesCount     Int      @default(0)
  rating         Float    @default(0)
  isVerified     Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  isInternal     Boolean  @default(false)
  suspendedUntil DateTime?
  suspendedReason String?
  bannedReason   String?
   customPermissions String?
   creatorStatus CreatorStatus @default(NONE)
   creatorTermsAcceptedAt DateTime?
   mfaSecret      String?
   mfaEnabled     Boolean  @default(false)
   mfaBackupCodes String?
   language       String   @default("en")
   currency       String   @default("USD")
   theme          String   @default("system")
   accentColor    String?     @default("#8B5CF6")
   reduceMotion   Boolean  @default(false)
   createdAt      DateTime @default(now())
   updatedAt      DateTime @updatedAt

  profile                 Profile?
  store                   Store?
  products                Product[]
  announcements           Announcement[]      @relation("AnnouncementAuthor")
  moderationNotes         ModerationNote[]    @relation("ModerationNoteAuthor")
  creatorApplications     CreatorApplication[] @relation("CreatorApplicationUser")
  creatorTerms            CreatorTerms?
  appeals                 Appeal[]
  orders                  Order[]
  ordersAsCreator         Order[]                  @relation("OrderCreator")
  orderGroups             OrderGroup[]
  reviews                 Review[]
  favorites               Favorite[]
  wishlistItems           WishlistItem[]
  collections             Collection[]
  posts                   Post[]
  followers               Follower[]               @relation("UserFollowers")
  following               Follower[]               @relation("UserFollowing")
  licenses                License[]
  downloads               Download[]
  notifications           Notification[]
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  supportTickets          SupportTicket[]
  reports                 Report[]                 @relation("ReportedUser")
  moderationActions       ModerationAction[]
  payouts                 Payout[]
  taxRecords              TaxRecord[]
  sessions                Session[]
  apiTokens               ApiToken[]
  auditLogs               AuditLog[]
  coupons                 Coupon[]
  bundles                 Bundle[]
  teamMembers             TeamMember[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  preferences             UserPreference?
  stripeConnectedAccount  StripeConnectedAccount?
  feedbackPosts           FeedbackPost[]
  feedbackVotes           FeedbackVote[]
  feedbackComments         FeedbackComment[]
  roadmapItems            RoadmapItem[]
  changelogEntries        ChangelogEntry[]
  supportTicketMessages   SupportTicketMessage[]
  emailPreferences        EmailPreference?
  privacySettings         PrivacySettings?
  emailMessages           EmailMessage[]
  uploadSessions          UploadSession[]
  mediaProcessingJobs     MediaProcessingJob[]
  staffPicksMade          StaffPick[]
  promotionsCreated       PromotedProduct[]
  stripeTransfersMade     StripeTransfer[]    @relation("StripeTransferCreator")
  creatorAllocations       CreatorAllocation[] @relation("CreatorAllocationCreator")
  recentlyViewed           RecentlyViewed[]
  backupsCreated           Backup[]
  errorsCaught             ErrorLog[]
  publishingDrafts         PublishingDraft[]
  tutorialsWritten         Tutorial[]
  apiDocumentsWritten      APIDocument[]
  recommendations          Recommendation[]
  searchAnalytics          SearchAnalytics[]
  badges                    CreatorBadge[]
  achievements             CreatorAchievement[]
  productNotifications     ProductNotification[]
  newsWritten              PlatformNews[]
  eventsCreated            Event[]
  giftCardsCreated         GiftCard[]
  storeCredits             StoreCredit[]
  contributor              Contributor?
  serviceProvider          ServiceProvider?
  avatarCommissioner       AvatarCommissioner?
  artCommissioner          ArtCommissioner?
  threeDServiceProvider    ThreeDServiceProvider?
  developmentServiceProvider DevelopmentServiceProvider?
  videoEditingServiceProvider VideoEditingServiceProvider?

  @@index([email])
  @@index([username])
}

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  bio             String?
  website         String?
  socialLinks     String?
  privacySettings String?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id               String   @id @default(cuid())
  userId           String   @unique
  name             String
  slug             String   @unique
  description      String?
  logo             String?
  banner           String?
  socialLinks      String?
  featuredProducts String?
  visibility       StoreVisibility @default(PUBLISHED)
  primaryColor     String?
  secondaryColor   String?
  customCss        String?
  announcements    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  bundles     Bundle[]
  teamMembers TeamMember[]

  @@index([slug])
  @@index([visibility])
}

model TeamMember {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  role      String   @default("editor")
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
}

model Product {
  id               String        @id @default(cuid())
  creatorId        String
  storeId          String?
  categoryId       String?
  title            String
  slug             String        @unique
  subtitle         String?
  description      String?
  price            Float
  salePrice        Float?
  isOnSale         Boolean       @default(false)
  saleStartsAt     DateTime?
  saleEndsAt       DateTime?
  isFree           Boolean       @default(false)
  isPublished      Boolean       @default(false)
  isFeatured       Boolean       @default(false)
  version          String?
  unityVersion     String?
  vrcSdkVersion    String?
  polygonCount     Int?
  fileSize         Int?
  questCompatible  Boolean       @default(false)
  pcCompatible     Boolean       @default(true)
  wholesaleEnabled Boolean       @default(false)
  wholesaleMinQty  Int?
  wholesalePrice   Float?
  licenseType      String?
  contentRating    ContentRating @default(SFW)
  status           ProductStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  creator         User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  store           Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media           ProductMedia[]
  files           ProductFile[]
  tags            ProductTag[]
  orderItems      OrderItem[]
  reviews         Review[]
  favorites       Favorite[]
  wishlistItems   WishlistItem[]
  collectionItems CollectionItem[]
  posts           Post[]
  licenses        License[]
  downloads       Download[]
  discounts       Discount[]
  bundleItems BundleItem[]
  cartItems   CartItem[]
  versions    ProductVersion[]
  staffPicks  StaffPick[]
  promotions  PromotedProduct[]
  recentlyViewed RecentlyViewed[]
  recommendations Recommendation[]
  productNotifications ProductNotification[]

  @@index([slug])
  @@index([creatorId])
  @@index([categoryId])
  @@index([isPublished])
  @@index([status])
}

model ProductMedia {
  id          String   @id @default(cuid())
  productId   String
  type        String
  url         String
  order       Int
  isThumbnail Boolean  @default(false)
  width       Int?
  height      Int?
  duration    Int?
  mimeType    String?
  checksum    String?
  thumbnailUrl String?
  blurDataUrl String?
  processingStatus String @default("READY")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  processingJobs MediaProcessingJob[]

  @@index([productId])
}

model ProductFile {
  id        String   @id @default(cuid())
  productId String
  filename  String
  url       String
  size      Int
  platform  String?
  version   String?
  folder    String?  @default("")
  mimeType  String?
  checksum  String?
  downloadCount Int @default(0)
  lastDownloadedAt DateTime?
  processingStatus String @default("READY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads Download[]
  processingJobs MediaProcessingJob[]

  @@index([productId])
  @@index([productId, folder])
}

model ProductVersion {
  id          String   @id @default(cuid())
  productId   String
  version     String
  changelog   String?
  releaseNotes String?
  isCurrent   Boolean  @default(false)
  isPrerelease Boolean @default(false)
  files       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, version])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  parentId    String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@index([displayOrder])
  @@index([isActive])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  description String?
  tagType   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTag[]

  @@index([slug])
  @@index([isActive])
  @@index([tagType])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  bundleId  String?
  quantity  Int     @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundle  Bundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
  @@index([bundleId])
}

model OrderGroup {
  id           String   @id @default(cuid())
  buyerId      String?
  creatorCount Int      @default(0)
  itemCount    Int      @default(0)
  subtotal     Float
  discount     Float    @default(0)
  total        Float
  currency     String   @default("USD")
  status       String   @default("PENDING")
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buyer  User?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([buyerId])
  @@index([status])
}

model Order {
  id                   String    @id @default(cuid())
  orderGroupId         String?
  buyerId              String?
  creatorId            String?
  total                Float
  subtotal             Float     @default(0)
  discount             Float     @default(0)
  currency             String    @default("USD")
  status               String    @default("PENDING")
  paymentIntentId      String?
  checkoutSessionId    String?   @unique
  stripeAccountId      String?
  applicationFeeAmount Float     @default(0)
  paidAt               DateTime?
  refundedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  buyer      User?           @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  creator    User?           @relation("OrderCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  orderGroup OrderGroup?     @relation(fields: [orderGroupId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payments   Payment[]
  refunds    Refund[]
  disputes   StripeDispute[]
  invoices   Invoice[]
  licenses   License[]
  downloads  Download[]
  transfers  StripeTransfer[]
  allocations CreatorAllocation[]

  @@index([buyerId])
  @@index([creatorId])
  @@index([orderGroupId])
  @@index([status])
  @@index([checkoutSessionId])
}

model OrderItem {
  id                    String  @id @default(cuid())
  orderId               String
  productId             String
  price                 Float
  quantity              Int     @default(1)
  creatorEarnings       Float   @default(0)
  platformFeeShare      Float   @default(0)
  contentRatingSnapshot String?
  productTitleSnapshot  String?
  productSlugSnapshot   String?
  productVersionSnapshot String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  allocation CreatorAllocation?

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                   String   @id @default(cuid())
  orderId              String
  amount               Float
  amountRefunded       Float    @default(0)
  currency             String   @default("USD")
  status               String   @default("PENDING")
  provider             String   @default("stripe")
  providerPaymentId    String?  @unique
  providerChargeId     String?  @unique
  stripeAccountId      String?
  applicationFeeAmount Float    @default(0)
  failureCode          String?
  failureMessage       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  disputes StripeDispute[]
  transfers StripeTransfer[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([providerChargeId])
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  paymentId        String?
  amount           Float
  currency         String   @default("USD")
  reason           String?
  status           String   @default("PENDING")
  provider         String   @default("stripe")
  providerRefundId String?  @unique
  stripeAccountId  String?
  itemIds          String?
  isPartial        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRefundId])
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  number    String
  url       String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model License {
  id             String        @id @default(cuid())
  userId         String
  productId      String
  orderId        String
  licenseKey     String        @unique
  status         LicenseStatus @default(ACTIVE)
  currentVersion String?
  lastAccessedAt DateTime?
  refundedAt     DateTime?
  disputedAt     DateTime?
  suspendedAt    DateTime?
  createdAt      DateTime      @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([licenseKey])
}

model Download {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  orderId      String
  fileId       String?
  downloadedAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  file    ProductFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([fileId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  userId       String
  rating       Int
  title        String?
  content      String?
  isVerified   Boolean  @default(false)
  helpfulCount Int      @default(0)
  creatorResponse String?
  creatorResponseAt DateTime?
  isReported   Boolean  @default(false)
  reportCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([isReported])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?
  coverImage  String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@unique([userId, slug])
  @@index([userId])
}

model CollectionItem {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  order        Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([productId])
}

model Post {
  id          String    @id @default(cuid())
  userId      String
  title       String
  slug        String
  content     String
  excerpt     String?
  status      PostStatus @default(DRAFT)
  image       String?
  contentRating ContentRating @default(SFW)
  productId   String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([userId, slug])
  @@index([userId])
  @@index([userId, status])
  @@index([publishedAt])
}

model Follower {
  followerId  String   @id @default(cuid())
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String
  amount      Float
  minPurchase Float?
  usageLimit  Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  creatorId   String?
  createdAt   DateTime  @default(now())

  creator User? @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([creatorId])
}

model Discount {
  id        String    @id @default(cuid())
  productId String
  type      String
  amount    Float
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Bundle {
  id          String   @id @default(cuid())
  creatorId   String
  storeId     String?
  name        String
  slug        String   @unique
  price       Float
  description String?
  coverImage  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  creator User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  store   Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items   BundleItem[]
  cartItems CartItem[]

  @@index([slug])
  @@index([creatorId])
  @@index([isPublished])
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String
  productId String
  order     Int    @default(0)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Message {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  subject   String?
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  from User @relation("SentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ReceivedMessages", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  category  String
  priority  String   @default("MEDIUM")
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  content   String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reportedType String
  reportedId   String
  reason       String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  reporter User               @relation("ReportedUser", fields: [reporterId], references: [id], onDelete: Cascade)
  actions  ModerationAction[]
  notes    ModerationNote[]

  @@index([reporterId])
