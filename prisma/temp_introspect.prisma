generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
  directUrl = env("DIRECT_URL")
}

model Announcement {
  id          String    @id
  title       String
  body        String
  authorId    String
  isPublished Boolean   @default(false)
  publishedAt DateTime? @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @db.Timestamp(6)
  User        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt])
}

model ApiToken {
  id        String    @id
  userId    String
  token     String    @unique
  scopes    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Appeal {
  id           String    @id
  userId       String
  type         String
  reason       String
  evidence     String?
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime? @db.Timestamp(6)
  resolution   String?
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @db.Timestamp(6)

  @@index([status])
  @@index([userId])
}

model AuditLog {
  id        String   @id
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model Bundle {
  id          String       @id
  creatorId   String
  storeId     String?
  name        String
  slug        String
  price       Float        @db.Real
  description String?
  coverImage  String?
  createdAt   DateTime     @default(now())
  User        User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  Store       Store?       @relation(fields: [storeId], references: [id])
  BundleItem  BundleItem[]

  @@index([creatorId])
  @@index([slug])
}

model BundleItem {
  id        String  @id
  bundleId  String
  productId String
  Bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  Product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([productId])
}

model Cart {
  id        String     @id
  userId    String?
  sessionId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime
  CartItem  CartItem[]

  @@index([sessionId])
  @@index([userId])
}

model CartItem {
  id        String   @id
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  Cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

model Category {
  id             String     @id
  name           String
  slug           String     @unique
  description    String?
  icon           String?
  parentId       String?
  createdAt      DateTime   @default(now())
  displayOrder   Int        @default(0)
  isActive       Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime   @default(now())
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Product        Product[]

  @@index([displayOrder])
  @@index([isActive])
  @@index([parentId])
  @@index([slug])
}

model ChangelogEntry {
  id          String   @id
  title       String
  summary     String?
  description String?
  category    String
  releaseDate DateTime
  authorId    String?
  feedbackId  String?
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [authorId], references: [id])

  @@index([category])
  @@index([createdAt])
  @@index([releaseDate])
}

model Collection {
  id             String           @id
  userId         String
  name           String
  slug           String
  description    String?
  coverImage     String?
  createdAt      DateTime         @default(now())
  isPublic       Boolean          @default(true)
  updatedAt      DateTime         @default(now())
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  CollectionItem CollectionItem[]

  @@unique([userId, slug])
  @@index([userId])
}

model CollectionItem {
  id           String     @id
  collectionId String
  productId    String
  order        Int
  Collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  Product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([productId])
}

model Coupon {
  id          String    @id
  code        String    @unique
  type        String
  amount      Float     @db.Real
  minPurchase Float?    @db.Real
  usageLimit  Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  creatorId   String?
  createdAt   DateTime  @default(now())
  User        User?     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([creatorId])
}

model CreatorAllocation {
  id             String    @id
  orderId        String
  orderItemId    String    @unique
  creatorId      String
  productId      String
  grossAmount    Float
  discountAmount Float     @default(0)
  taxAmount      Float     @default(0)
  platformFee    Float     @default(0)
  netAmount      Float
  currency       String    @default("USD")
  transferId     String?
  payoutId       String?
  isReversed     Boolean   @default(false)
  reversedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  User           User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  Order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  OrderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  Product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([isReversed])
  @@index([orderId])
  @@index([productId])
}

model CreatorApplication {
  id           String    @id
  userId       String
  displayName  String
  bio          String?
  website      String?
  socialLinks  String?
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime? @db.Timestamp(6)
  notes        String?
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @db.Timestamp(6)
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model CreatorTerms {
  id         String   @id
  userId     String   @unique
  version    String
  acceptedAt DateTime @default(now()) @db.Timestamp(6)
  ipAddress  String?

  @@index([userId])
}

model Discount {
  id        String    @id
  productId String
  type      String
  amount    Float     @db.Real
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  Product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Download {
  id           String   @id
  userId       String
  productId    String
  orderId      String
  fileId       String?
  downloadedAt DateTime @default(now())
  Order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([userId])
}

model EmailMessage {
  id                String    @id
  toEmail           String
  toUserId          String?
  templateKey       String
  templateVersion   Int?
  payload           Json?
  category          String
  priority          String    @default("NORMAL")
  status            String    @default("QUEUED")
  providerMessageId String?
  attempts          Int       @default(0)
  lastError         String?
  scheduledAt       DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  idempotencyKey    String?   @unique
  User              User?     @relation(fields: [toUserId], references: [id])

  @@index([status])
  @@index([toUserId])
}

model EmailPreference {
  id               String   @id
  userId           String   @unique
  security         Boolean  @default(true)
  account          Boolean  @default(true)
  orders           Boolean  @default(true)
  refunds          Boolean  @default(true)
  support          Boolean  @default(true)
  moderation       Boolean  @default(true)
  productUpdates   Boolean  @default(true)
  followedCreators Boolean  @default(false)
  marketing        Boolean  @default(false)
  updatedAt        DateTime
  createdAt        DateTime @default(now())
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailTemplate {
  id        String   @id
  key       String   @unique
  version   Int      @default(1)
  locale    String   @default("en")
  subject   String
  htmlBody  String
  textBody  String?
  category  String
  priority  String   @default("NORMAL")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([key])
}

model EmailVerificationToken {
  id        String    @id
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Favorite {
  id        String   @id
  userId    String
  productId String
  createdAt DateTime @default(now())
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model FeedbackComment {
  id           String       @id
  postId       String
  userId       String
  content      String
  isOfficial   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  FeedbackPost FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model FeedbackPost {
  id              String            @id
  userId          String
  title           String
  content         String
  category        String
  status          String            @default("OPEN")
  votes           Int               @default(0)
  isPinned        Boolean           @default(false)
  isLocked        Boolean           @default(false)
  duplicateOf     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  FeedbackComment FeedbackComment[]
  FeedbackVote    FeedbackVote[]

  @@index([category])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model FeedbackVote {
  id           String       @id
  postId       String
  userId       String
  createdAt    DateTime     @default(now())
  FeedbackPost FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model Follower {
  followerId                      String   @id
  followingId                     String
  createdAt                       DateTime @default(now())
  User_Follower_followerIdToUser  User     @relation("Follower_followerIdToUser", fields: [followerId], references: [id], onDelete: Cascade)
  User_Follower_followingIdToUser User     @relation("Follower_followingIdToUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Invoice {
  id        String   @id
  orderId   String   @unique
  number    String
  url       String?
  createdAt DateTime @default(now())
  Order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model License {
  id             String        @id
  userId         String
  productId      String
  orderId        String
  licenseKey     String        @unique
  status         LicenseStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  currentVersion String?
  lastAccessedAt DateTime?
  refundedAt     DateTime?
  disputedAt     DateTime?
  suspendedAt    DateTime?
  Order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  User           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([currentVersion])
  @@index([lastAccessedAt])
  @@index([licenseKey])
  @@index([orderId])
  @@index([productId])
  @@index([userId])
}

model MediaProcessingJob {
  id           String        @id
  mediaId      String?
  fileId       String?
  userId       String?
  type         String
  status       String        @default("QUEUED")
  inputKey     String
  outputKey    String?
  inputSize    Int?
  outputSize   Int?
  width        Int?
  height       Int?
  duration     Int?
  checksum     String?
  thumbnailUrl String?
  blurDataUrl  String?
  progress     Int           @default(0)
  attempts     Int           @default(0)
  lastError    String?
  scheduledAt  DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  ProductFile  ProductFile?  @relation(fields: [fileId], references: [id])
  ProductMedia ProductMedia? @relation(fields: [mediaId], references: [id])
  User         User?         @relation(fields: [userId], references: [id])

  @@index([fileId])
  @@index([mediaId])
  @@index([status])
  @@index([userId])
}

model Message {
  id                        String   @id
  fromId                    String
  toId                      String
  subject                   String?
  content                   String
  isRead                    Boolean  @default(false)
  createdAt                 DateTime @default(now())
  User_Message_fromIdToUser User     @relation("Message_fromIdToUser", fields: [fromId], references: [id], onDelete: Cascade)
  User_Message_toIdToUser   User     @relation("Message_toIdToUser", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
}

model ModerationAction {
  id        String   @id
  reportId  String
  adminId   String
  action    String
  notes     String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  Report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([reportId])
}

model ModerationNote {
  id        String   @id
  reportId  String?
  productId String?
  userId    String?
  authorId  String
  body      String
  createdAt DateTime @default(now()) @db.Timestamp(6)
  User      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  Report    Report?  @relation(fields: [reportId], references: [id])

  @@index([authorId])
  @@index([productId])
  @@index([reportId])
  @@index([userId])
}

model Notification {
  id        String   @id
  userId    String
  type      String
  title     String
  content   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isRead])
  @@index([userId])
}

model Order {
  id                         String              @id
  buyerId                    String?
  total                      Float               @db.Real
  status                     String              @default("PENDING")
  paymentIntentId            String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime
  orderGroupId               String?
  creatorId                  String?
  subtotal                   Float               @default(0)
  discount                   Float               @default(0)
  currency                   String              @default("USD")
  checkoutSessionId          String?             @unique
  stripeAccountId            String?
  applicationFeeAmount       Float               @default(0)
  paidAt                     DateTime?
  refundedAt                 DateTime?
  cancelledAt                DateTime?
  CreatorAllocation          CreatorAllocation[]
  Download                   Download[]
  Invoice                    Invoice?
  License                    License[]
  User_Order_buyerIdToUser   User?               @relation("Order_buyerIdToUser", fields: [buyerId], references: [id])
  User_Order_creatorIdToUser User?               @relation("Order_creatorIdToUser", fields: [creatorId], references: [id])
  OrderGroup                 OrderGroup?         @relation(fields: [orderGroupId], references: [id])
  OrderItem                  OrderItem[]
  Payment                    Payment[]
  Refund                     Refund[]
  StripeDispute              StripeDispute[]

  @@index([buyerId])
  @@index([checkoutSessionId])
  @@index([creatorId])
  @@index([orderGroupId])
  @@index([status])
}

model OrderGroup {
  id           String   @id
  buyerId      String?
  creatorCount Int      @default(0)
  itemCount    Int      @default(0)
  subtotal     Float
  discount     Float    @default(0)
  total        Float
  currency     String   @default("USD")
  status       String   @default("PENDING")
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Order        Order[]
  User         User?    @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id                     String             @id
  orderId                String
  productId              String
  price                  Float              @db.Real
  quantity               Int                @default(1)
  creatorEarnings        Float              @default(0)
  platformFeeShare       Float              @default(0)
  contentRatingSnapshot  String?
  productTitleSnapshot   String?
  productSlugSnapshot    String?
  productVersionSnapshot String?
  CreatorAllocation      CreatorAllocation?
  Order                  Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product                Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Payment {
  id                   String          @id
  orderId              String
  amount               Float           @db.Real
  currency             String          @default("USD")
  status               String          @default("PENDING")
  provider             String          @default("stripe")
  providerPaymentId    String?         @unique
  createdAt            DateTime        @default(now())
  amountRefunded       Float           @default(0)
  providerChargeId     String?         @unique
  stripeAccountId      String?
  applicationFeeAmount Float           @default(0)
  failureCode          String?
  failureMessage       String?
  updatedAt            DateTime        @default(now())
  Order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  StripeDispute        StripeDispute[]

  @@index([orderId])
  @@index([providerChargeId])
  @@index([providerPaymentId])
}

model Payout {
  id          String    @id
  creatorId   String
  amount      Float     @db.Real
  status      String    @default("PENDING")
  method      String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  User        User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([status])
}

model PlatformConfig {
  id                   String   @id @default("singleton")
  platformFeePercent   Float    @default(10)
  moderatorFeePercent  Float    @default(0)
  serverFeePercent     Float    @default(0)
  currency             String   @default("USD")
  stripeConnectEnabled Boolean  @default(true)
  updatedAt            DateTime
  createdAt            DateTime @default(now())
}

model Post {
  id            String        @id
  userId        String
  title         String
  slug          String
  content       String
  excerpt       String?
  status        PostStatus    @default(DRAFT)
  image         String?
  contentRating ContentRating @default(SFW)
  productId     String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  Product       Product?      @relation(fields: [productId], references: [id])
  User          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([publishedAt])
  @@index([userId])
  @@index([userId, status])
}

model Product {
  id                String              @id
  creatorId         String
  storeId           String?
  categoryId        String?
  title             String
  slug              String              @unique
  subtitle          String?
  description       String?
  price             Float               @db.Real
  salePrice         Float?              @db.Real
  isOnSale          Boolean             @default(false)
  saleStartsAt      DateTime?
  saleEndsAt        DateTime?
  isFree            Boolean             @default(false)
  isPublished       Boolean             @default(false)
  isFeatured        Boolean             @default(false)
  version           String?
  unityVersion      String?
  vrcSdkVersion     String?
  polygonCount      Int?
  fileSize          Int?
  questCompatible   Boolean             @default(false)
  pcCompatible      Boolean             @default(true)
  wholesaleEnabled  Boolean             @default(false)
  wholesaleMinQty   Int?
  wholesalePrice    Float?              @db.Real
  licenseType       String?
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  contentRating     ContentRating       @default(SFW)
  status            ProductStatus       @default(DRAFT)
  BundleItem        BundleItem[]
  CartItem          CartItem[]
  CollectionItem    CollectionItem[]
  CreatorAllocation CreatorAllocation[]
  Discount          Discount[]
  Download          Download[]
  Favorite          Favorite[]
  License           License[]
  OrderItem         OrderItem[]
  Post              Post[]
  Category          Category?           @relation(fields: [categoryId], references: [id])
  User              User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  Store             Store?              @relation(fields: [storeId], references: [id])
  ProductFile       ProductFile[]
  ProductMedia      ProductMedia[]
  ProductTag        ProductTag[]
  PromotedProduct   PromotedProduct[]
  Review            Review[]
  StaffPick         StaffPick[]
  WishlistItem      WishlistItem[]

  @@index([categoryId])
  @@index([contentRating])
  @@index([creatorId])
  @@index([isPublished])
  @@index([slug])
  @@index([status])
}

model ProductFile {
  id                 String               @id
  productId          String
  filename           String
  url                String
  size               Int
  platform           String?
  version            String?
  createdAt          DateTime             @default(now())
  folder             String               @default("")
  mimeType           String?
  checksum           String?
  downloadCount      Int                  @default(0)
  lastDownloadedAt   DateTime?
  processingStatus   String               @default("READY")
  updatedAt          DateTime             @default(now())
  MediaProcessingJob MediaProcessingJob[]
  Product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([folder])
  @@index([productId])
}

model ProductMedia {
  id                 String               @id
  productId          String
  type               String
  url                String
  order              Int
  isThumbnail        Boolean              @default(false)
  createdAt          DateTime             @default(now())
  processingStatus   String               @default("READY")
  width              Int?
  height             Int?
  duration           Int?
  mimeType           String?
  checksum           String?
  thumbnailUrl       String?
  blurDataUrl        String?
  updatedAt          DateTime             @default(now())
  MediaProcessingJob MediaProcessingJob[]
  Product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductModeration {
  id        String   @id
  productId String
  actorId   String
  action    String
  reason    String?
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([actorId])
  @@index([productId])
}

model ProductTag {
  productId String
  tagId     String
  Product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  Tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductVersion {
  id           String   @id
  productId    String
  version      String
  changelog    String?
  releaseNotes String?
  files        Json?
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@index([productId])
  @@index([productId, version])
}

model Profile {
  id              String  @id
  userId          String  @unique
  bio             String?
  website         String?
  socialLinks     String?
  privacySettings String?
  User            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PromotedProduct {
  id              String    @id
  productId       String
  creatorId       String
  stripeAccountId String?
  status          String    @default("PENDING")
  amount          Float
  currency        String    @default("USD")
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  User            User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  Product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([productId])
  @@index([status])
}

model Refund {
  id               String   @id
  orderId          String
  amount           Float    @db.Real
  reason           String?
  status           String   @default("PENDING")
  provider         String   @default("stripe")
  createdAt        DateTime @default(now())
  currency         String   @default("USD")
  paymentId        String?
  providerRefundId String?  @unique
  stripeAccountId  String?
  updatedAt        DateTime @default(now())
  Order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRefundId])
}

model Report {
  id               String             @id
  reporterId       String
  reportedType     String
  reportedId       String
  reason           String
  status           String             @default("PENDING")
  createdAt        DateTime           @default(now())
  ModerationAction ModerationAction[]
  ModerationNote   ModerationNote[]
  User             User               @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
}

model Review {
  id           String   @id
  productId    String
  userId       String
  rating       Int
  title        String?
  content      String?
  isVerified   Boolean  @default(false)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model RoadmapItem {
  id          String   @id
  title       String
  description String?
  status      String   @default("PLANNED")
  priority    String   @default("MEDIUM")
  feedbackId  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User?    @relation(fields: [createdById], references: [id])

  @@index([createdAt])
  @@index([priority])
  @@index([status])
}

model Session {
  id        String   @id
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  updatedBy String?
}

model StaffPick {
  id        String   @id
  productId String
  pickedBy  String
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [pickedBy], references: [id], onDelete: Cascade)
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, pickedBy])
  @@index([pickedBy])
  @@index([productId])
}

model Store {
  id               String          @id
  userId           String          @unique
  name             String
  slug             String          @unique
  description      String?
  logo             String?
  banner           String?
  socialLinks      String?
  featuredProducts String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  visibility       StoreVisibility @default(PUBLISHED)
  Bundle           Bundle[]
  Product          Product[]
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  TeamMember       TeamMember[]

  @@index([slug])
  @@index([visibility])
}

model StripeConnectedAccount {
  id                         String    @id
  userId                     String    @unique
  stripeAccountId            String    @unique
  accountType                String    @default("express")
  country                    String?
  defaultCurrency            String?
  emailOnAccount             String?
  businessType               String?
  chargesEnabled             Boolean   @default(false)
  payoutsEnabled             Boolean   @default(false)
  detailsSubmitted           Boolean   @default(false)
  capabilities               String?
  requirementsCurrentlyDue   String?
  requirementsEventuallyDue  String?
  requirementsDisabledReason String?
  isRestricted               Boolean   @default(false)
  isDisabled                 Boolean   @default(false)
  isDeleted                  Boolean   @default(false)
  disconnectedAt             DateTime?
  lastSyncedAt               DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime
  User                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chargesEnabled])
  @@index([payoutsEnabled])
  @@index([stripeAccountId])
}

model StripeDispute {
  id                 String    @id
  paymentId          String
  orderId            String?
  stripeDisputeId    String    @unique
  stripeChargeId     String?
  amount             Float
  currency           String    @default("USD")
  reason             String?
  status             String    @default("NEEDS_RESPONSE")
  evidenceDueBy      DateTime?
  isChargeRefundable Boolean   @default(false)
  raw                String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  Order              Order?    @relation(fields: [orderId], references: [id])
  Payment            Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
}

model StripeWebhookEvent {
  id            String    @id
  stripeEventId String    @unique
  type          String
  apiVersion    String?
  livemode      Boolean   @default(false)
  accountId     String?
  endpoint      String
  status        String    @default("PROCESSING")
  payload       String
  errorCategory String?
  errorMessage  String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  @@index([receivedAt])
  @@index([status])
  @@index([type])
}

model SupportTicket {
  id                   String                 @id
  userId               String
  subject              String
  category             String
  priority             String                 @default("MEDIUM")
  status               String                 @default("OPEN")
  createdAt            DateTime               @default(now())
  User                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  SupportTicketMessage SupportTicketMessage[]

  @@index([status])
  @@index([userId])
}

model SupportTicketMessage {
  id            String        @id
  ticketId      String
  userId        String
  content       String
  isStaff       Boolean       @default(false)
  createdAt     DateTime      @default(now())
  SupportTicket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  User          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Tag {
  id          String       @id
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  description String?
  tagType     String?
  isActive    Boolean      @default(true)
  updatedAt   DateTime     @default(now())
  ProductTag  ProductTag[]

  @@index([isActive])
  @@index([slug])
  @@index([tagType])
}

model TaxRecord {
  id        String   @id
  userId    String
  amount    Float    @db.Real
  type      String
  period    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TeamMember {
  id        String   @id
  storeId   String
  userId    String
  role      String   @default("editor")
  createdAt DateTime @default(now())
  Store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
}

model UploadSession {
  id                String    @id
  userId            String
  entityType        String
  entityId          String?
  folder            String
  filename          String
  fileSize          Int
  mimeType          String?
  status            String    @default("PENDING")
  chunkSize         Int       @default(5242880)
  uploadedBytes     Int       @default(0)
  completedKey      String?
  completedUrl      String?
  completedSize     Int?
  completedMimeType String?
  checksum          String?
  validationError   String?
  processingError   String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  User              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([status])
  @@index([userId])
}

model User {
  id                                  String                   @id
  email                               String                   @unique
  username                            String                   @unique
  passwordHash                        String
  displayName                         String?
  role                                String                   @default("USER")
  avatar                              String?
  bio                                 String?
  website                             String?
  location                            String?
  followersCount                      Int                      @default(0)
  followingCount                      Int                      @default(0)
  salesCount                          Int                      @default(0)
  rating                              Float                    @default(0) @db.Real
  isVerified                          Boolean                  @default(false)
  createdAt                           DateTime                 @default(now())
  updatedAt                           DateTime
  status                              UserStatus?              @default(ACTIVE)
  isFeatured                          Boolean?                 @default(false)
  suspendedUntil                      DateTime?                @db.Timestamp(6)
  suspendedReason                     String?
  bannedReason                        String?
  customPermissions                   String?
  creatorStatus                       CreatorStatus            @default(NONE)
  creatorTermsAcceptedAt              DateTime?                @db.Timestamp(6)
  isInternal                          Boolean                  @default(false)
  Announcement                        Announcement[]
  ApiToken                            ApiToken[]
  AuditLog                            AuditLog[]
  Bundle                              Bundle[]
  ChangelogEntry                      ChangelogEntry[]
  Collection                          Collection[]
  Coupon                              Coupon[]
  CreatorAllocation                   CreatorAllocation[]
  CreatorApplication                  CreatorApplication[]
  Download                            Download[]
  EmailMessage                        EmailMessage[]
  EmailPreference                     EmailPreference?
  EmailVerificationToken              EmailVerificationToken[]
  Favorite                            Favorite[]
  FeedbackComment                     FeedbackComment[]
  FeedbackVote                        FeedbackVote[]
  Follower_Follower_followerIdToUser  Follower?                @relation("Follower_followerIdToUser")
  Follower_Follower_followingIdToUser Follower[]               @relation("Follower_followingIdToUser")
  License                             License[]
  MediaProcessingJob                  MediaProcessingJob[]
  Message_Message_fromIdToUser        Message[]                @relation("Message_fromIdToUser")
  Message_Message_toIdToUser          Message[]                @relation("Message_toIdToUser")
  ModerationAction                    ModerationAction[]
  ModerationNote                      ModerationNote[]
  Notification                        Notification[]
  Order_Order_buyerIdToUser           Order[]                  @relation("Order_buyerIdToUser")
  Order_Order_creatorIdToUser         Order[]                  @relation("Order_creatorIdToUser")
  OrderGroup                          OrderGroup[]
  PasswordResetToken                  PasswordResetToken[]
  Payout                              Payout[]
  Post                                Post[]
  Product                             Product[]
  Profile                             Profile?
  PromotedProduct                     PromotedProduct[]
  Report                              Report[]
  Review                              Review[]
  RoadmapItem                         RoadmapItem[]
  Session                             Session[]
  StaffPick                           StaffPick[]
  Store                               Store?
  StripeConnectedAccount              StripeConnectedAccount?
  SupportTicket                       SupportTicket[]
  SupportTicketMessage                SupportTicketMessage[]
  TaxRecord                           TaxRecord[]
  TeamMember                          TeamMember[]
  UploadSession                       UploadSession[]
  UserPreference                      UserPreference?
  WishlistItem                        WishlistItem[]

  @@index([creatorStatus])
  @@index([email])
  @@index([isInternal])
  @@index([status])
  @@index([username])
}

model UserModeration {
  id        String    @id
  userId    String
  actorId   String
  action    String
  reason    String?
  expiresAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)

  @@index([actorId])
  @@index([userId])
}

model UserPreference {
  id               String    @id
  userId           String    @unique
  showAdultContent Boolean   @default(false)
  adultConfirmedAt DateTime?
  blurNsfwPreviews Boolean   @default(true)
  updatedAt        DateTime
  createdAt        DateTime  @default(now())
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String   @id
  userId    String
  productId String
  createdAt DateTime @default(now())
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

enum ContentRating {
  SFW
  MATURE
  NSFW
}

enum CreatorStatus {
  NONE
  APPLICATION_DRAFT
  APPLICATION_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  BANNED
  WITHDRAWN
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  REFUNDED
  DISPUTED
  SUSPENDED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
  ARCHIVED
  REJECTED
  SUSPENDED
  CHANGES_REQUESTED
  REMOVED
}

enum StoreVisibility {
  PUBLISHED
  HIDDEN
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}
